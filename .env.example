# Copy to .env (gitignored). Never commit real keys.
# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
POSTGRES_PASSWORD=autolp
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# Provider credentials (read-only keys). Nested settings use "__".
JUPITER__API_KEY=
HELIUS__API_KEY=
# DEX Screener and GeckoTerminal need no key.

# Collection tuning (defaults in backend/src/autolp/config.py: CollectionSettings), e.g.:
# COLLECTION__CANDLES_MAX_TOKENS=60
# COLLECTION__MANUAL_EXCLUDE_MINTS=["<mint>"]
